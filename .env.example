# ---------------------------------------------------------------------------
# Origin — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed. No secret in this file is a real credential.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=development
# Public origin of this app, used for CORS and absolute links.
APP_BASE_URL=http://localhost:5173

# --- LLM provider -----------------------------------------------------------
# live   = call DeepRelay for real
# mock   = deterministic fixtures, no network. Clearly labelled in the UI.
LLM_MODE=live
DEEPRELAY_BASE_URL=https://api.deeprelay.ai/v1
DEEPRELAY_API_KEY=
DEEPRELAY_MODEL=deepseek-v4.1-flash
# Hard cap on output tokens per agent call (the model spends tokens on reasoning).
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=90000

# --- SWITCH integration -----------------------------------------------------
# live   = real switch-core agent protocol over HTTP + WebSocket
# offline= development-only mock; the UI shows an explicit offline badge
SWITCH_MODE=live
SWITCH_BRIDGE_URL=http://127.0.0.1:43059
# Deployment registration key (POST /agents). Server-side only. Never exposed.
SWITCH_REGISTRATION_TOKEN=
# Reuse existing registered agents instead of registering again on boot.
SWITCH_REUSE_AGENTS=true

# --- Human collaboration ----------------------------------------------------
# Mattermost bridge id for the connected SWITCH workspace. Discovered at boot
# when empty.
SWITCH_MATTERMOST_BRIDGE_ID=
# Shared secret an operator presents in the Origin console to cast a human vote.
# Preferred path is the real Mattermost/SWITCH room; this is the fallback.
HUMAN_OPERATOR_TOKEN=

# --- Discovery sources ------------------------------------------------------
# GitHub raises its unauthenticated limit from 60 to 5000 req/hr when set.
GITHUB_TOKEN=
DISCOVERY_HN_MAX_STORIES=60
DISCOVERY_GITHUB_MAX_ISSUES=40

# --- Build sandbox ----------------------------------------------------------
# Absolute path to the opencode binary used by the Builder agent.
OPENCODE_BIN=opencode
OPENCODE_MODEL=deeprelay/deeprelay/deepseek-v4.1-flash
BUILD_TIMEOUT_MS=600000
QA_TIMEOUT_MS=120000
MAX_QA_RETRIES=2

# --- Persistence ------------------------------------------------------------
DATA_DIR=./data
WORKSPACE_DIR=./workspace
